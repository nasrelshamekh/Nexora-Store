# ========================================================
# Nexora Store - Environment Configuration Template
# Duplicate this file as .env.local for local development:
#   cp .env.example .env.local
# ========================================================

# Route Academy eCommerce Backend REST API Base URL
NEXT_PUBLIC_SITE_URL=https://ecommerce.routemisr.com/api/v1

# NextAuth Secret Key for session signing & JWT encryption
# (Generate a secure secret: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_key_here_at_least_32_characters

# Fallback alias for NextAuth secret
AUTH_SECRET=your_nextauth_secret_key_here_at_least_32_characters

# NextAuth Canonical App Base URL
NEXTAUTH_URL=http://localhost:3000
